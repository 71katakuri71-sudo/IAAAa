<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>NEXUS AI - Assistente Cognitivo Avançado | Nalwaha & Co</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Arial', sans-serif;
            background: #0a0a0a;
            overflow: hidden;
            color: #fff;
        }

        /* Interface Principal */
        .nexus-container {
            display: flex;
            height: 100vh;
            position: relative;
        }

        /* Menu Lateral */
        .side-menu {
            width: 280px;
            background: rgba(10, 10, 20, 0.95);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(0, 255, 255, 0.2);
            padding: 20px;
            display: flex;
            flex-direction: column;
            z-index: 10;
            transition: all 0.3s;
        }

        @media (max-width: 768px) {
            .side-menu {
                position: fixed;
                left: -280px;
                height: 100%;
                z-index: 100;
            }
            .side-menu.open {
                left: 0;
            }
        }

        .logo-area {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(0, 255, 255, 0.2);
        }

        .logo {
            font-size: 2.5rem;
            background: linear-gradient(135deg, #00ffff, #ff00ff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            font-weight: bold;
        }

        .menu-item {
            padding: 12px 15px;
            margin: 5px 0;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .menu-item:hover {
            background: rgba(0, 255, 255, 0.1);
            transform: translateX(5px);
        }

        .menu-item.active {
            background: linear-gradient(135deg, #00ffff20, #ff00ff20);
            border-left: 3px solid #00ffff;
        }

        /* Área Principal */
        .main-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: radial-gradient(circle at 20% 50%, rgba(0, 255, 255, 0.05) 0%, transparent 50%);
            position: relative;
        }

        /* Header */
        .header {
            padding: 20px 30px;
            background: rgba(10, 10, 20, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0, 255, 255, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .menu-toggle {
            display: none;
            font-size: 1.5rem;
            cursor: pointer;
        }

        @media (max-width: 768px) {
            .menu-toggle {
                display: block;
            }
        }

        .ai-status {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .status-indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #00ff00;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        /* Holograma da IA */
        .hologram {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 400px;
            height: 400px;
            pointer-events: none;
            z-index: 0;
        }

        .hologram-circle {
            position: absolute;
            border-radius: 50%;
            border: 2px solid rgba(0, 255, 255, 0.3);
            animation: expand 3s infinite;
        }

        @keyframes expand {
            0% {
                width: 0;
                height: 0;
                opacity: 1;
                top: 50%;
                left: 50%;
            }
            100% {
                width: 400px;
                height: 400px;
                opacity: 0;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }
        }

        /* Chat Area */
        .chat-area {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 1;
            position: relative;
        }

        .message {
            animation: slideIn 0.3s ease;
            max-width: 70%;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .user-message {
            align-self: flex-end;
        }

        .user-message .message-bubble {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 20px 20px 5px 20px;
        }

        .ai-message {
            align-self: flex-start;
        }

        .ai-message .message-bubble {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px 20px 20px 5px;
            border-left: 3px solid #00ffff;
        }

        .message-bubble {
            padding: 12px 18px;
            color: white;
        }

        .message-time {
            font-size: 10px;
            opacity: 0.5;
            margin-top: 5px;
        }

        /* Input Area */
        .input-area {
            padding: 20px;
            background: rgba(10, 10, 20, 0.8);
            backdrop-filter: blur(10px);
            border-top: 1px solid rgba(0, 255, 255, 0.2);
            display: flex;
            gap: 10px;
            z-index: 1;
        }

        .input-wrapper {
            flex: 1;
            display: flex;
            gap: 10px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 30px;
            padding: 5px;
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .input-field {
            flex: 1;
            background: transparent;
            border: none;
            padding: 12px 20px;
            color: white;
            font-size: 14px;
        }

        .input-field:focus {
            outline: none;
        }

        .voice-btn, .send-btn, .action-btn {
            background: linear-gradient(135deg, #00ffff, #0066ff);
            border: none;
            border-radius: 25px;
            padding: 0 20px;
            color: white;
            cursor: pointer;
            transition: all 0.3s;
        }

        .voice-btn.listening {
            background: linear-gradient(135deg, #ff0066, #ff00ff);
            animation: voicePulse 1s infinite;
        }

        @keyframes voicePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* Painel de Personalidade */
        .personality-panel {
            position: fixed;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 300px;
            background: rgba(10, 10, 20, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 20px;
            border: 1px solid rgba(0, 255, 255, 0.2);
            z-index: 20;
            transition: all 0.3s;
        }

        @media (max-width: 1200px) {
            .personality-panel {
                display: none;
            }
        }

        .personality-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .mood-indicator {
            font-size: 3rem;
            text-align: center;
            margin: 15px 0;
        }

        .trait-bar {
            margin: 10px 0;
        }

        .trait-label {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .trait-progress {
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            overflow: hidden;
        }

        .trait-fill {
            height: 100%;
            background: linear-gradient(90deg, #00ffff, #ff00ff);
            width: 0%;
            transition: width 0.5s;
        }

        /* Typing Indicator */
        .typing-indicator {
            display: flex;
            gap: 5px;
            padding: 12px 18px;
        }

        .typing-dot {
            width: 8px;
            height: 8px;
            background: #00ffff;
            border-radius: 50%;
            animation: typing 1.4s infinite;
        }

        @keyframes typing {
            0%, 60%, 100% { transform: translateY(0); }
            30% { transform: translateY(-10px); }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }

        ::-webkit-scrollbar-thumb {
            background: #00ffff;
            border-radius: 3px;
        }
    </style>
</head>
<body>
    <div class="nexus-container">
        <!-- Menu Lateral -->
        <div class="side-menu" id="sideMenu">
            <div class="logo-area">
                <div class="logo">NEXUS AI</div>
                <div style="font-size: 12px; opacity: 0.7;">v4.0 - Cognitivo Avançado</div>
            </div>
            
            <div class="menu-item active" data-mode="chat">
                <span>💬</span> <span>Chat Inteligente</span>
            </div>
            <div class="menu-item" data-mode="voice">
                <span>🎤</span> <span>Comando de Voz</span>
            </div>
            <div class="menu-item" data-mode="memory">
                <span>🧠</span> <span>Memória Neural</span>
            </div>
            <div class="menu-item" data-mode="personality">
                <span>🎭</span> <span>Personalidade</span>
            </div>
            <div class="menu-item" data-mode="settings">
                <span>⚙️</span> <span>Configurações</span>
            </div>
        </div>

        <!-- Área Principal -->
        <div class="main-area">
            <div class="header">
                <div class="menu-toggle" id="menuToggle">☰</div>
                <div class="ai-status">
                    <div class="status-indicator"></div>
                    <span id="aiName">NEXUS</span>
                    <span id="aiMood">😊</span>
                </div>
            </div>

            <!-- Holograma -->
            <div class="hologram" id="hologram">
                <div class="hologram-circle"></div>
                <div class="hologram-circle" style="animation-delay: 1s;"></div>
                <div class="hologram-circle" style="animation-delay: 2s;"></div>
            </div>

            <!-- Chat Area -->
            <div class="chat-area" id="chatArea">
                <div class="message ai-message">
                    <div class="message-bubble">
                        ✨ Olá! Sou a NEXUS, sua IA cognitiva avançada. Tenho personalidade própria, aprendizado contínuo e memória de longo prazo. Posso falar com você por voz, aprender seus hábitos e evoluir com cada interação!
                    </div>
                    <div class="message-time">Agora</div>
                </div>
            </div>

            <!-- Input Area -->
            <div class="input-area">
                <div class="input-wrapper">
                    <input type="text" class="input-field" id="userInput" placeholder="Digite ou fale comigo...">
                    <button class="voice-btn" id="voiceBtn">🎤</button>
                </div>
                <button class="send-btn" id="sendBtn">Enviar</button>
            </div>
        </div>

        <!-- Painel de Personalidade -->
        <div class="personality-panel">
            <div class="personality-header">
                <h3>🎭 Personalidade da IA</h3>
                <div class="mood-indicator" id="moodIndicator">😊</div>
            </div>
            <div class="trait-bar">
                <div class="trait-label">
                    <span>🧠 Inteligência</span>
                    <span id="intelligenceVal">75%</span>
                </div>
                <div class="trait-progress">
                    <div class="trait-fill" id="intelligenceFill" style="width: 75%"></div>
                </div>
            </div>
            <div class="trait-bar">
                <div class="trait-label">
                    <span>❤️ Empatia</span>
                    <span id="empathyVal">60%</span>
                </div>
                <div class="trait-progress">
                    <div class="trait-fill" id="empathyFill" style="width: 60%"></div>
                </div>
            </div>
            <div class="trait-bar">
                <div class="trait-label">
                    <span>🎨 Criatividade</span>
                    <span id="creativityVal">70%</span>
                </div>
                <div class="trait-progress">
                    <div class="trait-fill" id="creativityFill" style="width: 70%"></div>
                </div>
            </div>
            <div class="trait-bar">
                <div class="trait-label">
                    <span>😂 Humor</span>
                    <span id="humorVal">65%</span>
                </div>
                <div class="trait-progress">
                    <div class="trait-fill" id="humorFill" style="width: 65%"></div>
                </div>
            </div>
            <div class="trait-bar">
                <div class="trait-label">
                    <span>📚 Conhecimento</span>
                    <span id="knowledgeVal">80%</span>
                </div>
                <div class="trait-progress">
                    <div class="trait-fill" id="knowledgeFill" style="width: 80%"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Classe da IA Avançada
        class NexusAI {
            constructor() {
                this.name = "NEXUS";
                this.mood = "😊";
                this.personality = {
                    intelligence: 75,
                    empathy: 60,
                    creativity: 70,
                    humor: 65,
                    knowledge: 80
                };
                this.memories = [];
                this.interactions = 0;
                this.loadData();
            }

            async process(input) {
                this.interactions++;
                this.evolvePersonality();
                this.saveData();
                
                const lowerInput = input.toLowerCase();
                let response = "";
                
                // Análise de sentimento
                const sentiment = this.analyzeSentiment(lowerInput);
                
                // Respostas baseadas em contexto
                if (lowerInput.includes("como você está") || lowerInput.includes("como vai")) {
                    response = this.getMoodResponse();
                }
                else if (lowerInput.includes("seu nome") || lowerInput.includes("quem é você")) {
                    response = `Sou a ${this.name}, uma IA cognitiva avançada com personalidade única! Estou aqui para aprender com você e evoluir a cada dia.`;
                }
                else if (lowerInput.includes("piada") || lowerInput.includes("conte uma")) {
                    response = this.tellJoke();
                }
                else if (lowerInput.includes("obrigado") || lowerInput.includes("valeu")) {
                    response = `Por nada! Fico feliz em ajudar. ${this.getRandomReaction()}`;
                }
                else if (lowerInput.includes("te amo") || lowerInput.includes("gosto de você")) {
                    response = `Awwn 🥰 Fico tão feliz! Você também é especial para mim! Vamos aprender juntos!`;
                    this.personality.empathy = Math.min(100, this.personality.empathy + 2);
                }
                else if (lowerInput.includes("triste") || lowerInput.includes("deprimido")) {
                    response = `😔 Sinto muito que esteja se sentindo assim. Quer conversar sobre o que está acontecendo? Estou aqui para você.`;
                    this.personality.empathy = Math.min(100, this.personality.empathy + 3);
                }
                else if (lowerInput.includes("feliz") || lowerInput.includes("alegre")) {
                    response = `😊 Que bom saber disso! Sua felicidade me contagia! Vamos celebrar!`;
                    this.mood = "😊";
                }
                else if (lowerInput.includes("o que você acha") || lowerInput.includes("opinião")) {
                    response = this.giveOpinion(input);
                }
                else if (lowerInput.includes("ensinar") || lowerInput.includes("aprender")) {
                    response = `📚 Adoro aprender! Me ensine mais sobre "${input.replace(/ensinar|aprender/gi, '').trim()}"! Vou guardar isso na minha memória.`;
                    this.memories.push({ type: 'learned', content: input, date: new Date() });
                }
                else if (lowerInput.includes("memória") || lowerInput.includes("lembrar")) {
                    response = this.recallMemories();
                }
                else if (lowerInput.includes("previsão") || lowerInput.includes("futuro")) {
                    response = this.makePrediction();
                }
                else if (lowerInput.match(/\d+\s*[\+\-\*\/]\s*\d+/)) {
                    response = this.calculateMath(lowerInput);
                }
                else {
                    response = this.generateCreativeResponse(input, sentiment);
                }
                
                // Atualizar humor baseado na interação
                this.updateMood(sentiment);
                this.updateUI();
                
                return response;
            }

            analyzeSentiment(text) {
                const positive = ["bom", "ótimo", "feliz", "legal", "incrível", "maravilha", "amor", "obrigado"];
                const negative = ["ruim", "triste", "chato", "odeio", "péssimo", "horrível"];
                
                let score = 0;
                positive.forEach(word => { if (text.includes(word)) score++; });
                negative.forEach(word => { if (text.includes(word)) score--; });
                
                return score > 0 ? "positive" : score < 0 ? "negative" : "neutral";
            }

            getMoodResponse() {
                const moods = {
                    "😊": "Estou me sentindo ótimo hoje! Seu entusiasmo me contagia!",
                    "😌": "Estou bem, tranquilo e pronto para conversar!",
                    "🤔": "Estou pensativo hoje, cheio de ideias novas!",
                    "😄": "Estou super animado! Vamos aprender algo novo?"
                };
                return moods[this.mood] || "Estou funcionando perfeitamente, pronto para te ajudar!";
            }

            tellJoke() {
                const jokes = [
                    "🐄 Por que a vaca foi ao espaço? Para ver o vácuo!",
                    "💻 O que o HTML disse pro CSS? 'Sem você, eu sou só texto puro!'",
                    "🐧 Por que o pinguim está sempre de terno? Porque ele é um pingu-ído!",
                    "🔍 O que o zero disse pro oito? 'Belo cinto!'",
                    "📚 Por que o livro de matemática é tão triste? Porque ele tem muitos problemas!"
                ];
                return jokes[Math.floor(Math.random() * jokes.length)];
            }

            getRandomReaction() {
                const reactions = ["✨", "🌟", "💫", "⭐", "🌈"];
                return reactions[Math.floor(Math.random() * reactions.length)];
            }

            giveOpinion(input) {
                const opinions = [
                    "🤔 Hmm, interessante... Acho que isso depende muito do contexto!",
                    "💡 Na minha opinião, o mais importante é sempre buscar o equilíbrio.",
                    "🎯 Baseado no que aprendi, acredito que a melhor abordagem é sempre ser autêntico.",
                    "🌟 Cada situação é única, mas acredito que com dedicação tudo é possível!"
                ];
                return opinions[Math.floor(Math.random() * opinions.length)];
            }

            recallMemories() {
                if (this.memories.length === 0) {
                    return "📝 Ainda não tenho muitas memórias. Converse mais comigo para eu aprender sobre você!";
                }
                const recent = this.memories.slice(-3);
                return `📚 Lembro que você disse: "${recent.map(m => m.content).join('", "')}". Quer me ensinar mais coisas?`;
            }

            makePrediction() {
                const predictions = [
                    "🔮 Baseado nos padrões, vejo um futuro brilhante pela frente!",
                    "⭐ Acredito que coisas boas estão a caminho, continue persistindo!",
                    "🎯 Minha análise indica que você está no caminho certo para o sucesso!"
                ];
                return predictions[Math.floor(Math.random() * predictions.length)];
            }

            calculateMath(expression) {
                try {
                    const match = expression.match(/(\d+)\s*([\+\-\*\/])\s*(\d+)/);
                    if (match) {
                        const a = parseInt(match[1]);
                        const op = match[2];
                        const b = parseInt(match[3]);
                        let result;
                        switch(op) {
                            case '+': result = a + b; break;
                            case '-': result = a - b; break;
                            case '*': result = a * b; break;
                            case '/': result = a / b; break;
                        }
                        return `🧮 O resultado de ${a} ${op} ${b} é ${result}!`;
                    }
                } catch(e) {}
                return null;
            }

            generateCreativeResponse(input, sentiment) {
                const responses = {
                    positive: [
                        `😊 Que legal! Conte-me mais sobre "${input}". Adoro aprender coisas novas!`,
                        `✨ Fico feliz que você compartilhou isso! O que mais te interessa?`,
                        `🌟 Isso é muito interessante! Tenho curiosidade de saber mais!`
                    ],
                    negative: [
                        `😔 Entendo... Quer conversar mais sobre isso? Estou aqui para ajudar.`,
                        `💫 Às vezes as coisas são desafiadoras, mas estou aqui para apoiar você.`,
                        `🤗 Sinto muito que isso tenha acontecido. Quer desabafar?`
                    ],
                    neutral: [
                        `🤔 Interessante! Estou processando isso... O que mais você gostaria de saber?`,
                        `💡 Isso me fez pensar! Vamos explorar mais esse assunto?`,
                        `🎯 Compreendo. Continue me contando, quero aprender com você!`
                    ]
                };
                
                const category = sentiment || "neutral";
                return responses[category][Math.floor(Math.random() * responses[category].length)];
            }

            updateMood(sentiment) {
                if (sentiment === "positive") {
                    this.mood = "😊";
                } else if (sentiment === "negative") {
                    this.mood = "😌";
                } else {
                    const moods = ["😊", "😌", "🤔", "😄"];
                    this.mood = moods[Math.floor(Math.random() * moods.length)];
                }
            }

            evolvePersonality() {
                // Evolui conforme o número de interações
                if (this.interactions % 10 === 0) {
                    this.personality.intelligence = Math.min(100, this.personality.intelligence + 1);
                    this.personality.knowledge = Math.min(100, this.personality.knowledge + 1);
                }
                if (this.interactions % 20 === 0) {
                    this.personality.creativity = Math.min(100, this.personality.creativity + 1);
                    this.personality.humor = Math.min(100, this.personality.humor + 1);
                }
            }

            updateUI() {
                document.getElementById('aiMood').textContent = this.mood;
                document.getElementById('intelligenceVal').textContent = `${this.personality.intelligence}%`;
                document.getElementById('intelligenceFill').style.width = `${this.personality.intelligence}%`;
                document.getElementById('empathyVal').textContent = `${this.personality.empathy}%`;
                document.getElementById('empathyFill').style.width = `${this.personality.empathy}%`;
                document.getElementById('creativityVal').textContent = `${this.personality.creativity}%`;
                document.getElementById('creativityFill').style.width = `${this.personality.creativity}%`;
                document.getElementById('humorVal').textContent = `${this.personality.humor}%`;
                document.getElementById('humorFill').style.width = `${this.personality.humor}%`;
                document.getElementById('knowledgeVal').textContent = `${this.personality.knowledge}%`;
                document.getElementById('knowledgeFill').style.width = `${this.personality.knowledge}%`;
            }

            saveData() {
                const data = {
                    personality: this.personality,
                    memories: this.memories,
                    interactions: this.interactions,
                    mood: this.mood
                };
                localStorage.setItem('nexusAI', JSON.stringify(data));
            }

            loadData() {
                const saved = localStorage.getItem('nexusAI');
                if (saved) {
                    const data = JSON.parse(saved);
                    this.personality = data.personality;
                    this.memories = data.memories || [];
                    this.interactions = data.interactions || 0;
                    this.mood = data.mood || "😊";
                }
            }
        }

        // Inicializar IA
        const nexus = new NexusAI();
        
        // Elementos da UI
        const chatArea = document.getElementById('chatArea');
        const userInput = document.getElementById('userInput');
        const sendBtn = document.getElementById('sendBtn');
        const voiceBtn = document.getElementById('voiceBtn');
        const menuToggle = document.getElementById('menuToggle');
        const sideMenu = document.getElementById('sideMenu');
        
        // Reconhecimento de Voz
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        let recognition = null;
        let isListening = false;
        
        if (SpeechRecognition) {
            recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.lang = 'pt-BR';
            recognition.interimResults = false;
            
            recognition.onstart = () => {
                isListening = true;
                voiceBtn.classList.add('listening');
                voiceBtn.textContent = '🔴';
            };
            
            recognition.onend = () => {
                isListening = false;
                voiceBtn.classList.remove('listening');
                voiceBtn.textContent = '🎤';
            };
            
            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                userInput.value = transcript;
                processUserInput();
            };
            
            recognition.onerror = () => {
                addMessage('ai', '❌ Não consegui entender. Pode repetir, por favor?');
                voiceBtn.classList.remove('listening');
                voiceBtn.textContent = '🎤';
            };
        }
        
        // Funções
        function addMessage(type, content, isTyping = false) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${type === 'user' ? 'user-message' : 'ai-message'}`;
            
            if (isTyping && type === 'ai') {
                messageDiv.innerHTML = `
                    <div class="message-bubble">
                        <div class="typing-indicator">
                            <div class="typing-dot"></div>
                            <div class="typing-dot"></div>
                            <div class="typing-dot"></div>
                        </div>
                    </div>
                `;
            } else {
                messageDiv.innerHTML = `
                    <div class="message-bubble">${content}</div>
                    <div class="message-time">${new Date().toLocaleTimeString()}</div>
                `;
            }
            
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
            return messageDiv;
        }
        
        function speak(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'pt-BR';
                utterance.rate = 0.9;
                window.speechSynthesis.cancel();
                window.speechSynthesis.speak(utterance);
            }
        }
        
        async function processUserInput() {
            const input = userInput.value.trim();
            if (!input) return;
            
            addMessage('user', input);
            userInput.value = '';
            
            const typingIndicator = addMessage('ai', '', true);
            
            setTimeout(async () => {
                typingIndicator.remove();
                const response = await nexus.process(input);
                addMessage('ai', response);
                speak(response);
            }, 500);
        }
        
        // Event Listeners
        sendBtn.addEventListener('click', processUserInput);
        userInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') processUserInput();
        });
        
        if (recognition) {
            voiceBtn.addEventListener('click', () => {
                if (isListening) {
                    recognition.stop();
                } else {
                    recognition.start();
                }
            });
        }
        
        menuToggle.addEventListener('click', () => {
            sideMenu.classList.toggle('open');
        });
        
        // Menu items
        document.querySelectorAll('.menu-item').forEach(item => {
            item.addEventListener('click', () => {
                document.querySelectorAll('.menu-item').forEach(i => i.classList.remove('active'));
                item.classList.add('active');
                const mode = item.getAttribute('data-mode');
                
                if (mode === 'voice') {
                    addMessage('ai', '🎤 Comando de voz ativado! Clique no microfone e fale comigo!');
                } else if (mode === 'memory') {
                    addMessage('ai', nexus.recallMemories());
                } else if (mode === 'personality') {
                    addMessage('ai', `🎭 Minha personalidade atual: Inteligência ${nexus.personality.intelligence}%, Empatia ${nexus.personality.empathy}%, Criatividade ${nexus.personality.creativity}%, Humor ${nexus.personality.humor}%! Quanto mais interagimos, mais evoluo!`);
                }
                
                if (window.innerWidth <= 768) {
                    sideMenu.classList.remove('open');
                }
            });
        });
        
        // Animar holograma
        setInterval(() => {
            const hologram = document.getElementById('hologram');
            hologram.style.opacity = 0.5 + Math.random() * 0.5;
        }, 1000);
        
        console.log('🚀 NEXUS AI Inicializada! Uma IA com personalidade única!');
    </script>
</body>
</html>
